-- Comandos de Fling/Kill (Universal)
local function ModernFling(target)
    local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
    local thrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if hrp and thrp then
        local oldPos = hrp.CFrame
        local bamv = Instance.new("BodyAngularVelocity", hrp)
        bamv.P = 1500
        bamv.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bamv.AngularVelocity = Vector3.new(0, 99999, 0)
        local timer = tick() + 1.2
        while tick() < timer do
            hrp.CFrame = thrp.CFrame
            hrp.Velocity = Vector3.new(600, 600, 600)
            task.wait()
        end
        bamv:Destroy()
        hrp.CFrame = oldPos
    end
end

TabCmd:Button({ Title = ";KillPlus", Callback = function()
    local t = getTarget()
    if t then 
        Instance.new("Explosion", t.Character).Position = t.Character.HumanoidRootPart.Position
        ModernFling(t) 
    end
end})

TabCmd:Button({ Title = ";Fling", Callback = function()
    local t = getTarget()
